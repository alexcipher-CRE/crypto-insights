---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.title }}</title>
    <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
    <link href="{{ site.url | append: site.baseurl }}/"/>
    <updated>{{ site.time | date: '%Y-%m-%dT%H:%M:%SZ' }}</updated>
    <id>{{ site.url | append: site.baseurl }}/</id>
    <author>
        <name>{{ site.author.name | default: 'Alex Cipher' }}</name>
    </author>
    {% for post in site.posts limit:20 %}
    <entry>
        <title>{{ post.title | xml_escape }}</title>
        <link href="{{ post.url | absolute_url }}"/>
        <updated>{{ post.date | date: '%Y-%m-%dT%H:%M:%SZ' }}</updated>
        <id>{{ post.url | absolute_url }}</id>
        <summary>{{ post.excerpt | default: post.content | truncate: 500 | xml_escape }}</summary>
        {% for tag in post.tags %}
        <category term="{{ tag }}"/>
        {% endfor %}
    </entry>
    {% endfor %}
</feed>
